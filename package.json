{
  "name": "laminarflow-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && npm run check:boundary",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:pull": "node scripts/api-pull.mjs && npm run api:types",
    "api:types": "npx -y openapi-typescript@7.13.0 api/openapi.json -o src/api/schema.d.ts",
    "preview": "vite preview",
    "check:boundary": "node scripts/check-no-db-driver.mjs"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.23",
    "@solidjs/web": "2.0.0-rc.7",
    "idb": "8.0.4",
    "openapi-fetch": "^0.17.0",
    "solid-js": "2.0.0-rc.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@solidjs/signals": "2.0.0-rc.7",
    "@solidjs/compiler": "2.0.0-rc.8",
    "@solidjs/babel-plugin": "2.0.0-rc.8"
  }
}
